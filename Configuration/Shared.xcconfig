PRODUCT_NAME = Roomlings
PRODUCT_BUNDLE_IDENTIFIER = com.roomlings.app
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_VERSION = 6.0
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
ROOMLINGS_UNIVERSAL_LINKS = NO
ROOMLINGS_APP_ID_PREFIX =
ROOMLINGS_ENTITLEMENTS_NO = Roomlings/Roomlings.entitlements
ROOMLINGS_ENTITLEMENTS_YES = Roomlings/RoomlingsLinks.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = $(ROOMLINGS_ENTITLEMENTS_$(ROOMLINGS_UNIVERSAL_LINKS))
ENABLE_USER_SCRIPT_SANDBOXING = NO
ROOMLINGS_WEB_ROOT = $(PROJECT_DIR)/../roomlings
NODE_BINARY = /opt/homebrew/bin/node
